# ─────────────────────────────────────────────────────────
# SafeWatch AI — Environment Configuration
# Copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────

# ── Azure OpenAI ─────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Azure AI Search (Compliance RAG) ─────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=safewatch-regulations

# ── Azure AI Vision / Custom Vision (PPE Detection) ──────
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=
AZURE_VISION_PROJECT_ID=
AZURE_VISION_ITERATION_NAME=

# ── Azure AI Document Intelligence ───────────────────────
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=

# ── Azure Blob Storage ───────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_IMAGES=site-images
AZURE_STORAGE_CONTAINER_DOCS=compliance-docs

# ── Azure Cosmos DB (Incident Record) ────────────────────
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=safewatch
COSMOS_CONTAINER_INCIDENTS=incidents

# ── HITL Notification (MCP) ──────────────────────────────
NOTIFICATION_PROVIDER=sendgrid          # sendgrid | teams | logicapp
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=
SAFETY_OFFICER_EMAIL=
HSE_MANAGER_EMAIL=

# ── Governance Policy Thresholds ─────────────────────────
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80

# ── Application ──────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
