          <mxGeometry x="200" y="1210" width="290" height="106" as="geometry" />
        </mxCell>
        <mxCell id="papim" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color='#8A97A4' style='font-size:10px'&gt;Azure API Management&lt;br&gt;&lt;br&gt;Rate limiting, versioning, subscription&lt;br&gt;keys, usage analytics. Needed at&lt;br&gt;multiple external consumers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE7;dashed=1;fontSize=11;fontColor=#5A6B7B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="1210" width="290" height="106" as="geometry" />
        </mxCell>
        <mxCell id="pbus" value="&lt;b&gt;Async Decoupling&lt;/b&gt;&lt;br&gt;&lt;font color='#8A97A4' style='font-size:10px'&gt;Azure Service Bus&lt;br&gt;&lt;br&gt;Queue-based agent decoupling and&lt;br&gt;backpressure. Needed at continuous&lt;br&gt;stream volume, not batch images.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE7;dashed=1;fontSize=11;fontColor=#5A6B7B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="1210" width="290" height="106" as="geometry" />
        </mxCell>

        <mxCell id="paudit" value="&lt;b&gt;Audit Data Lake&lt;/b&gt;&lt;br&gt;&lt;font color='#8A97A4' style='font-size:10px'&gt;Long-term traceability: model version,&lt;br&gt;prompt version, policy version, full&lt;br&gt;AI + human decision history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE7;dashed=1;fontSize=11;fontColor=#5A6B7B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="1336" width="290" height="94" as="geometry" />
        </mxCell>
        <mxCell id="pwatch" value="&lt;b&gt;Watcher Agent&lt;/b&gt;&lt;br&gt;&lt;font color='#8A97A4' style='font-size:10px'&gt;Recurring violations, rising site risk,&lt;br&gt;approval backlog, contractor&lt;br&gt;performance deterioration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE7;dashed=1;fontSize=11;fontColor=#5A6B7B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="1336" width="290" height="94" as="geometry" />
        </mxCell>
        <mxCell id="ppred" value="&lt;b&gt;Predictive Safety Layer&lt;/b&gt;&lt;br&gt;&lt;font color='#8A97A4' style='font-size:10px'&gt;Trend detection → risk forecast →&lt;br&gt;preventive recommendation, ahead&lt;br&gt;of the incident&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE7;dashed=1;fontSize=11;fontColor=#5A6B7B;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="1336" width="290" height="94" as="geometry" />
        </mxCell>

        <mxCell id="prodnote" value="Deferred by design. Edge security and gateway policies protect an application that has external consumers; v1 proves the governance loop. Trend detection and forecasting require a decision history that does not exist at v1." style="text;html=1;fontSize=11;fontColor=#9AA7B4;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="200" y="1444" width="910" height="30" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="SafeWatch AI  ·  Reference Architecture  ·  Nadeem Ahmad  ·  v1.0" style="text;html=1;fontSize=10;fontColor=#B0BAC4;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1520" width="600" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
